{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "disableClaudeAiConnectors": true,
  "includeGitInstructions": false,
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh issue list *)",
      "Bash(gh issue status *)",
      "Bash(gh issue view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh pr status *)",
      "Bash(gh pr view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run status *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh search *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(git blame *)",
      "Bash(git diff *)",
      "Bash(git grep *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-tree *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(nix build *)",
      "Bash(nix fmt *)",
      "Bash(nix log *)",
      "Bash(nix-build *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(which *)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.renovatebot.com)",
      "WebFetch(domain:ryota2357.com)"
    ],
    "deny": [
      "Bash(sudo *)"
    ],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/coding-agent/claude-code/statusline.sh"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/coding-agent/claude-code/hooks/notification.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/coding-agent/claude-code/hooks/stop.sh",
            "async": true
          }
        ]
      }
    ]
  }
}

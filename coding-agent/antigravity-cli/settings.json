{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "agentMode": "",
  "altScreenMode": "always",
  "colorScheme": "dark",
  "model": "Gemini 4 Hydrogen (High)",
  "notifications": true,
  "pickerGrouping": "grouped",
  "verbosity": "high",
  "statusLine": {
    "type": "command",
    "command": "~/dotfiles/coding-agent/antigravity-cli/statusline.sh"
  },
  "permissions": {
    "allow": [
      "command(gh issue list)",
      "command(gh issue status)",
      "command(gh issue view)",
      "command(gh pr checks)",
      "command(gh pr diff)",
      "command(gh pr list)",
      "command(gh pr status)",
      "command(gh pr view)",
      "command(gh release list)",
      "command(gh release view)",
      "command(gh repo list)",
      "command(gh repo view)",
      "command(gh run list)",
      "command(gh run status)",
      "command(gh run view)",
      "command(gh run watch)",
      "command(gh search)",
      "command(gh workflow list)",
      "command(gh workflow view)",
      "command(git blame)",
      "command(git diff)",
      "command(git grep)",
      "command(git log)",
      "command(git ls-files)",
      "command(git ls-remote)",
      "command(git ls-tree)",
      "command(git show)",
      "command(git status)",
      "command(git submodule status)",
      "command(git submodule summary)",
      "command(grep)",
      "command(head)",
      "command(ls)",
      "command(nix build)",
      "command(nix fmt)",
      "command(nix log)",
      "command(nix-build)",
      "command(pwd)",
      "command(rg)",
      "command(stat)",
      "command(tail)",
      "command(wc)",
      "command(which)",
      "read_file(/Users/ryota2357/dotfiles)",
      "read_url(ryota2357.com)"
    ],
    "deny": [
      "command(sudo)",
      "read_file(.env)",
      "write_file(.env)"
    ]
  }
}
